{
  "name": "pixel-kit",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace root for the pixel-art packages and the studio.",
  "license": "(MIT AND CC-BY-4.0)",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter ./studio dev",
    "build": "pnpm --filter \"./packages/*\" build",
    "build:studio": "pnpm --filter ./studio build",
    "preview:studio": "pnpm --filter ./studio preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter \"./packages/*\" test",
    "size": "pnpm --filter ./packages/pixel-sprites size",
    "new": "pnpm --filter ./packages/pixel-sprites new",
    "check:masks": "pnpm --filter ./packages/pixel-sprites check:masks",
    "stats": "pnpm --filter ./packages/pixel-sprites stats",
    "docs:images": "pnpm --filter ./packages/pixel-sprites docs:images",
    "changelog": "pnpm --filter ./packages/pixel-sprites changelog",
    "changelog:write": "pnpm --filter ./packages/pixel-sprites changelog:write"
  }
}
